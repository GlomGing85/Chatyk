{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".validate": "$room.length <= 64",
        "messages": {
          ".read": "auth != null",
          "$msgId": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 'ts'])",
            "uid": {
              ".validate": "newData.isString()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 2000 && (newData.val().length >= 1 || newData.parent().hasChild('photo'))"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "photo": {
              ".validate": "newData.hasChildren(['id', 'w', 'h', 'bytes'])",
              "id": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
              },
              "w": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4096"
              },
              "h": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4096"
              },
              "bytes": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 2000000"
              },
              "$other": {
                ".validate": false
              }
            },
            "reactions": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid",
                ".validate": "auth.uid === $uid && newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "photos": {
          ".read": "auth != null",
          "$photoId": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid', 'data', 'ts'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "data": {
              ".validate": "newData.isString() && newData.val().length >= 100 && newData.val().length <= 400000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "presence": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChild('lastSeen')",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "lastSeen": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
